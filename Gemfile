source "https://rubygems.org"

# Local development server for the site.
# NOTE: GitHub Pages (classic) builds with the `github-pages` gem (Jekyll 3.x),
# but that stack is not compatible with modern Ruby. The `{% include %}` and
# front matter behavior used by this site is identical in Jekyll 4, so we use
# the modern Jekyll for local preview.
gem "jekyll", "~> 4.3"

gem "webrick", "~> 1.8"
